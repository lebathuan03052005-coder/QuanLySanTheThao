{
  "name": "sportlink-backend",
  "version": "1.0.0",
  "description": "SportLink API Server — Node.js + Express 5 + SQL Server",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "dev": "node --watch src/app.js",
    "start": "node src/app.js",
    "db:migrate": "node --env-file=.env src/scripts/migrate_sprint2.js",
    "db:seed": "node --env-file=.env src/scripts/seed_sprint2.js",
    "seed:wbs31": "node --env-file=.env src/scripts/seed_sprint2.js",
    "test:sprint2": "node --env-file=.env src/scripts/test_sprint2_specs.js",
    "test:tc01": "node src/scripts/test_tc01_dynamic_pricing.js",
    "test:s207": "node --env-file=.env src/scripts/test_s2_07_pricing.js",

/**
 * Biến môi trường — Sao chép file này thành .env và điền giá trị thực.
 * KHÔNG commit file .env lên git.
 */

# Server
PORT=3000
NODE_ENV=development

# Database (SQL Server)
DB_SERVER=localhost
DB_NAME=sportlink_db
DB_USER=sa
DB_PASSWORD=your_password_here
DB_PORT=1433

# JWT
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=7d
